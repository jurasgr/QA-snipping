{
  "manifest_version": 3,
  "name": "QA Snipping Tool",
  "version": "2.0",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "take_screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Запусціць QA Snipping Tool"
    }
  }
}