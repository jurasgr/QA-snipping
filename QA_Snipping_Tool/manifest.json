{
  "manifest_version": 3,
  "name": "QA Snipping Tool",
  "version": "2.0",
  "description": "Інструмент для хуткага стварэння скрыншотаў і капіявання спасылак для QA.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "take_screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Запусціць QA Snipping Tool"
    }
  }
}
